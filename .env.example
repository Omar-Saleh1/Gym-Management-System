PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gym_system
JWT_SECRET=change_this_secret_key_in_production
FRONTEND_URL=http://localhost:3000

# WhatsApp — local (whatsapp-web.js) | meta | twilio | mock
WHATSAPP_PROVIDER=local
WWEBJS_AUTH_PATH=/tmp/.wwebjs_auth
WWEBJS_CACHE_PATH=/tmp/.wwebjs_cache
# Optional: pin WhatsApp Web version (version string or full HTML URL)
# WA_WEB_VERSION=2.3000.1017054665
# WA_WEB_VERSION=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.3000.xxxxx.html
# Docker/Render (set automatically in Dockerfile):
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
